# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public frontend values only.
# Never add private tokens with VITE_. They are exposed to the browser bundle.

# Solo para scripts locales de catálogo (nunca con prefijo VITE_):
# PEXELS_API_KEY=...   # gratis en https://www.pexels.com/api/new/ — usada por scripts/seed-pexels-videos.mjs

# Supabase Edge Function secrets (configure with `supabase secrets set`, not in Vite):
# MERCADOPAGO_ACCESS_TOKEN=...
# MERCADOPAGO_WEBHOOK_SECRET=...
# MERCADOPAGO_WEBHOOK_URL=https://your-project-id.supabase.co/functions/v1/mercadopago-webhook
# PRO_PLAN_PRICE=99900
# PRO_PLAN_CURRENCY=COP
# ALLOWED_CORS_ORIGINS=https://proclama.lat,http://localhost:5173,http://localhost:4173
# API_BIBLE_KEY=...
# PAYMENTS_ADMIN_EMAIL=security@example.com
