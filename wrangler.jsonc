{
  "name": "proclama",
  "compatibility_date": "2025-11-01",
  // Sin `main`: Worker de solo assets estáticos (dist/ generado por `pnpm build`).
  "assets": {
    "directory": "./dist",
    // Equivale al rewrite a /index.html de vercel.json
    "not_found_handling": "single-page-application"
  }
}
